#version 460
// Minimal inline ray-tracing (ray query) trace: cast one ray from a push-constant
// origin/direction against the scene TLAS and write the closest hit (distance +
// instance id) to a storage buffer. Verifies hardware ray query end-to-end; the DDGI
// gather reuses this exact accelerationStructureEXT + storage-buffer descriptor pattern.
#extension GL_EXT_ray_query : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) buffer Out {
    float t;      // hit distance (-1 if miss)
    uint  hit;    // 1 on hit, 0 on miss
    uint  instId; // gl_InstanceCustomIndexEXT of the hit (0xFFFFFFFF on miss)
    uint  pad;
} o;

layout(push_constant) uniform PC {
    vec4 origin; // xyz
    vec4 dir;    // xyz (normalized)
} pc;

void main() {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu,
                          pc.origin.xyz, 0.001, pc.dir.xyz, 1000.0);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) ==
        gl_RayQueryCommittedIntersectionTriangleEXT) {
        o.hit = 1u;
        o.t = rayQueryGetIntersectionTEXT(rq, true);
        o.instId = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
    } else {
        o.hit = 0u;
        o.t = -1.0;
        o.instId = 0xFFFFFFFFu;
    }
}
