#version 460
// DDGI probe gather with REAL hit shading. For each probe, shoot N rays (ray query vs the
// scene TLAS) and project incoming radiance into an L1 SH basis (4 coeffs per channel).
// A miss samples the sky. A HIT reads the surface's actual vertices + albedo via bindless
// geometry (per-instance table indexed by gl_InstanceID) and shades it with the same
// directional light the forward pass uses — so probes gather true-coloured bounced light
// (one bounce; add previous-frame irradiance here later for multi-bounce).
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
// Probe SH POOL: 3 vec4 per probe, indexed by (slot*probesPerBrick + localProbe).
layout(set = 0, binding = 1, std430) buffer Irr { vec4 probes[]; };

struct Vtx { vec3 pos; vec3 nrm; vec2 uv; };
layout(buffer_reference, scalar) readonly buffer Verts { Vtx v[]; };
layout(buffer_reference, scalar) readonly buffer Indices { uint i[]; };
struct Inst { uint64_t vtxAddr; uint64_t idxAddr; vec4 albedo; };
layout(set = 0, binding = 2, std430) readonly buffer InstTable { Inst insts[]; };
// Per-brick pool slot: index into the probe pool, or -1 = unallocated (skip). The volume is
// tiled into bricks of `brick.x` probes/side; the CPU slot assignment fills this.
layout(set = 0, binding = 3, std430) readonly buffer BrickSlots { int brickSlot[]; };
// Directional occluder-distance moments (mean, mean^2) — 6 axis faces = 3 vec4 per probe,
// indexed by pool probe like the SH. For Chebyshev visibility in the apply (anti-leak).
layout(set = 0, binding = 4, std430) buffer Depth { vec4 dm[]; };

int axisFace(vec3 d) { // dominant axis + sign -> face 0..5 (+x,-x,+y,-y,+z,-z)
    vec3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) return d.x >= 0.0 ? 0 : 1;
    if (a.y >= a.z) return d.y >= 0.0 ? 2 : 3;
    return d.z >= 0.0 ? 4 : 5;
}

layout(push_constant) uniform PC {
    vec4 origin;
    ivec4 counts;  // xyz grid, w = rays per probe
    vec4 sky;
    vec4 spacing;  // x = spacing, y = blend (new-sample weight), z = phase, w = divisor
    ivec4 brick;   // x = brick size (probes/side), yzw = brick grid dims
    ivec4 scroll;  // xyz = origin brick-lattice coord (toroidal window base)
} pc;

int pmod(int a, int b) { return ((a % b) + b) % b; }

vec3 sphereDir(int i, int n) {
    const float golden = 2.39996323;
    float y = 1.0 - (float(i) + 0.5) / float(n) * 2.0;
    float r = sqrt(max(0.0, 1.0 - y * y));
    float t = golden * float(i);
    return vec3(cos(t) * r, y, sin(t) * r);
}
vec4 shBasis(vec3 d) {
    return vec4(0.282095, 0.488603 * d.y, 0.488603 * d.z, 0.488603 * d.x);
}

// Cosine-convolved L1 SH irradiance for a normal (Ramamoorthi) — matches the apply.
float shEval(vec4 c, vec3 n) {
    return max(0.886227 * c.x + 1.023328 * (c.y * n.y + c.z * n.z + c.w * n.x), 0.0);
}
ivec3 floorDivB(ivec3 a, int b) { return ivec3(floor(vec3(a) / float(b))); }

// Sample THIS volume's probe field (the previous frame's irradiance) at a world point +
// normal — the same toroidal trilinear the apply uses. Reading probes[] mid-gather is a
// benign race (mostly last frame's values); temporal accumulation converges it. Feeding this
// back into hit shading gives an extra light bounce per frame (multi-bounce GI).
vec3 sampleField(vec3 wp, vec3 n) {
    int B = pc.brick.x;
    ivec3 bc = pc.brick.yzw;
    ivec3 ob = pc.scroll.xyz;
    vec3 g = wp / pc.spacing.x;
    ivec3 base = ivec3(floor(g));
    vec3 f = g - vec3(base);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 8; ++i) {
        ivec3 o = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 pl = base + o;
        ivec3 bl = floorDivB(pl, B);
        if (any(lessThan(bl, ob)) || any(greaterThanEqual(bl, ob + bc))) continue;
        ivec3 bs = ivec3(pmod(bl.x, bc.x), pmod(bl.y, bc.y), pmod(bl.z, bc.z));
        int bIdx = (bs.z * bc.y + bs.y) * bc.x + bs.x;
        int slot = brickSlot[bIdx];
        if (slot < 0) continue;
        ivec3 lp = pl - bl * B;
        int q = slot * (B * B * B) + (lp.z * B + lp.y) * B + lp.x;
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        float w = w3.x * w3.y * w3.z;
        sum += w * vec3(shEval(probes[q * 3 + 0], n), shEval(probes[q * 3 + 1], n),
                        shEval(probes[q * 3 + 2], n));
        wsum += w;
    }
    return wsum > 0.0 ? sum / wsum : vec3(0.0);
}

// Shade a ray hit: interpolate the surface normal, direct-light its albedo, and add the
// indirect light the hit surface itself received (from the field) for multi-bounce — the
// outgoing radiance the probe gathers. Normal is mesh-space (fine for un-rotated instances).
vec3 shadeHit(rayQueryEXT rq, vec3 rayOrigin, vec3 rayDir) {
    uint ii = uint(rayQueryGetIntersectionInstanceIdEXT(rq, true));
    int prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    vec2 bc = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    Inst inst = insts[ii];
    Indices idx = Indices(inst.idxAddr);
    Verts vtx = Verts(inst.vtxAddr);
    uint i0 = idx.i[prim * 3 + 0], i1 = idx.i[prim * 3 + 1], i2 = idx.i[prim * 3 + 2];
    vec3 n = normalize(vtx.v[i0].nrm * (1.0 - bc.x - bc.y) + vtx.v[i1].nrm * bc.x +
                       vtx.v[i2].nrm * bc.y);
    vec3 sun = normalize(vec3(0.4, 1.0, 0.3));
    float d = max(dot(n, sun), 0.0);
    vec3 hitPos = rayOrigin + rayDir * rayQueryGetIntersectionTEXT(rq, true);
    vec3 indirect = sampleField(hitPos, n) * 0.3183099; // previous-frame irradiance / pi
    return inst.albedo.rgb * (0.3 + 0.7 * d + indirect);
}

void main() {
    int p = int(gl_GlobalInvocationID.x);
    int total = pc.counts.x * pc.counts.y * pc.counts.z;
    if (p >= total) return;
    // Budgeted round-robin: with divisor N, each probe updates once every N frames (this
    // frame handles the probes whose index ≡ phase mod N), so the gather's ray cost is
    // ~1/N. Probes not scheduled this frame keep their stored irradiance untouched.
    int divisor = int(pc.spacing.w);
    if (divisor > 1 && (p % divisor) != int(pc.spacing.z)) return;
    int px = p % pc.counts.x;
    int py = (p / pc.counts.x) % pc.counts.y;
    int pz = p / (pc.counts.x * pc.counts.y);
    // Sparse pool: find this probe's brick slot. Unallocated (-1) bricks — empty space, or
    // over the storage budget — have no pool storage and are never sampled, so cast no rays.
    int B = pc.brick.x;
    ivec3 bc = pc.brick.yzw;
    ivec3 bs = ivec3(px, py, pz) / B;            // STORAGE brick
    int bIdx = (bs.z * bc.y + bs.y) * bc.x + bs.x;
    int slot = brickSlot[bIdx];
    if (slot < 0) return;
    // Toroidal: unwrap the storage brick to its lattice brick in the current window, so a
    // scrolled volume gathers each storage cell for the WORLD position it now covers.
    ivec3 obMod = ivec3(pmod(pc.scroll.x, bc.x), pmod(pc.scroll.y, bc.y), pmod(pc.scroll.z, bc.z));
    ivec3 rel = ivec3(pmod(bs.x - obMod.x, bc.x), pmod(bs.y - obMod.y, bc.y), pmod(bs.z - obMod.z, bc.z));
    ivec3 bl = pc.scroll.xyz + rel;              // lattice brick
    ivec3 lp = ivec3(px, py, pz) - bs * B;       // local probe coords within the brick
    int po = slot * (B * B * B) + (lp.z * B + lp.y) * B + lp.x; // pool probe index
    vec3 probePos = vec3(bl * B + lp) * pc.spacing.x;           // toroidal world position

    int n = pc.counts.w;
    vec4 accR = vec4(0.0), accG = vec4(0.0), accB = vec4(0.0);
    float maxDist = pc.spacing.x * 8.0; // occluder distances clamped to the local neighbourhood
    vec2 dacc[6];
    float dcnt[6];
    for (int k = 0; k < 6; ++k) { dacc[k] = vec2(0.0); dcnt[k] = 0.0; }
    for (int i = 0; i < n; ++i) {
        vec3 dir = sphereDir(i, n);
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, probePos, 0.01, dir,
                              1000.0);
        while (rayQueryProceedEXT(rq)) {}
        vec3 L;
        float dist;
        if (rayQueryGetIntersectionTypeEXT(rq, true) ==
            gl_RayQueryCommittedIntersectionTriangleEXT) {
            L = shadeHit(rq, probePos, dir);
            dist = min(rayQueryGetIntersectionTEXT(rq, true), maxDist);
        } else {
            L = pc.sky.rgb;
            dist = maxDist; // a miss = no occluder that way (fully visible)
        }
        vec4 Y = shBasis(dir);
        accR += L.r * Y;
        accG += L.g * Y;
        accB += L.b * Y;
        int fc = axisFace(dir); // splat the occluder distance into its axis face
        dacc[fc] += vec2(dist, dist * dist);
        dcnt[fc] += 1.0;
    }
    float w = 4.0 * 3.14159265 / float(n);
    // Temporal accumulation: blend this frame's gather into the stored SH (blend = weight
    // of the NEW sample; 1.0 = overwrite/no history, small = heavy smoothing). Converges to
    // the true irradiance for a static scene and hides the staggered round-robin updates.
    float blend = pc.spacing.y;
    probes[po * 3 + 0] = mix(probes[po * 3 + 0], accR * w, blend);
    probes[po * 3 + 1] = mix(probes[po * 3 + 1], accG * w, blend);
    probes[po * 3 + 2] = mix(probes[po * 3 + 2], accB * w, blend);

    // Directional depth: blend each face's (mean, mean^2) moments; faces with no rays this
    // frame keep their stored value. 6 faces packed as 3 vec4 (faces 2k in .xy, 2k+1 in .zw).
    vec4 pv0 = dm[po * 3 + 0], pv1 = dm[po * 3 + 1], pv2 = dm[po * 3 + 2];
    vec2 m0 = dcnt[0] > 0.0 ? mix(pv0.xy, dacc[0] / dcnt[0], blend) : pv0.xy;
    vec2 m1 = dcnt[1] > 0.0 ? mix(pv0.zw, dacc[1] / dcnt[1], blend) : pv0.zw;
    vec2 m2 = dcnt[2] > 0.0 ? mix(pv1.xy, dacc[2] / dcnt[2], blend) : pv1.xy;
    vec2 m3 = dcnt[3] > 0.0 ? mix(pv1.zw, dacc[3] / dcnt[3], blend) : pv1.zw;
    vec2 m4 = dcnt[4] > 0.0 ? mix(pv2.xy, dacc[4] / dcnt[4], blend) : pv2.xy;
    vec2 m5 = dcnt[5] > 0.0 ? mix(pv2.zw, dacc[5] / dcnt[5], blend) : pv2.zw;
    dm[po * 3 + 0] = vec4(m0, m1);
    dm[po * 3 + 1] = vec4(m2, m3);
    dm[po * 3 + 2] = vec4(m4, m5);
}
