#version 450
// Software-GI scene proxy: rasterize one mesh's triangles into the voxel grid so the software
// DDGI gather (ddgi_gather_sw.comp) can ray-march it (the non-RT fallback for the hardware
// TLAS). One thread per triangle; each stamps the voxels it covers with occupancy + the
// instance albedo + the triangle's world normal (last writer wins — fine for low-frequency GI).
layout(local_size_x = 64) in;

// bb::Vertex is 8 floats: pos(3), normal(3), uv(2), tightly packed (stride 32B) — read raw so
// the std430 vec3-alignment rule can't mismatch the C++ layout.
layout(std430, binding = 0) readonly buffer Verts { float verts[]; };
layout(std430, binding = 1) readonly buffer Idx { uint indices[]; };
layout(std430, binding = 2) buffer Voxels { uvec2 voxels[]; }; // per voxel: (albedo|occ, normal)

layout(push_constant) uniform PC {
    mat4 model;     // instance world transform
    vec4 origin;    // xyz = grid origin (world position of voxel 0,0,0); w = voxel spacing
    ivec4 counts;   // xyz = grid dimensions; w = triangle count
    vec4 albedo;    // instance surface albedo (rgb)
} pc;

vec3 vpos(uint i) { return vec3(verts[i * 8u + 0u], verts[i * 8u + 1u], verts[i * 8u + 2u]); }

uint packAlbedoOcc(vec3 c) {
    uvec3 q = uvec3(clamp(c, 0.0, 1.0) * 255.0 + 0.5);
    return 0x01000000u | (q.r << 16) | (q.g << 8) | q.b; // high byte != 0 marks "occupied"
}
uint packNormal(vec3 n) {
    uvec3 q = uvec3((clamp(n, -1.0, 1.0) * 0.5 + 0.5) * 255.0 + 0.5);
    return (q.r << 16) | (q.g << 8) | q.b;
}

void stamp(vec3 pw, uint alb, uint nrm) {
    ivec3 c = ivec3(floor((pw - pc.origin.xyz) / pc.origin.w));
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, pc.counts.xyz))) return;
    uint idx = uint((c.z * pc.counts.y + c.y) * pc.counts.x + c.x);
    voxels[idx] = uvec2(alb, nrm);
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= uint(pc.counts.w)) return;

    vec3 p0 = (pc.model * vec4(vpos(indices[t * 3u + 0u]), 1.0)).xyz;
    vec3 p1 = (pc.model * vec4(vpos(indices[t * 3u + 1u]), 1.0)).xyz;
    vec3 p2 = (pc.model * vec4(vpos(indices[t * 3u + 2u]), 1.0)).xyz;
    vec3 n = normalize(cross(p1 - p0, p2 - p0));
    uint alb = packAlbedoOcc(pc.albedo.rgb);
    uint nrm = packNormal(n);

    // Barycentric sampling dense enough (<= one voxel apart) to cover every voxel the triangle
    // passes through. Steps scale with the longest edge in voxels; clamped so a giant triangle
    // can't runaway. Conservative coverage is all a coarse occlusion proxy needs.
    float sp = pc.origin.w;
    float maxEdge = max(length(p1 - p0), max(length(p2 - p1), length(p0 - p2)));
    int steps = clamp(int(ceil(maxEdge / sp)) + 1, 1, 160);
    for (int i = 0; i <= steps; ++i)
        for (int j = 0; j <= steps - i; ++j) {
            float u = float(i) / float(steps);
            float v = float(j) / float(steps);
            stamp(p0 * (1.0 - u - v) + p1 * u + p2 * v, alb, nrm);
        }
}
