#version 450
// SOFTWARE DDGI gather — the non-RT fallback. Identical to ddgi_gather.comp (same probe layout,
// SH projection, amortization, bricks, toroidal window, multi-bounce, Chebyshev depth) EXCEPT
// the ray-cast: instead of a hardware ray query vs the TLAS, it DDA-marches the VoxelScene grid
// (voxelize.comp output). A hit reads the voxel's baked albedo + normal; a miss is sky. Output
// (the SH probe pool) is byte-compatible with the hardware path, so the apply is unchanged.
layout(local_size_x = 64) in;

// Voxel scene proxy: uvec2 per voxel — .x = (occupied<<24)|albedoRGB, .y = packed normal.
layout(set = 0, binding = 0, std430) readonly buffer Voxels { uvec2 voxels[]; };
layout(set = 0, binding = 1, std430) buffer Irr { vec4 probes[]; };       // SH pool (as HW)
layout(set = 0, binding = 2, std430) readonly buffer BrickSlots { int brickSlot[]; };
layout(set = 0, binding = 3, std430) buffer Depth { vec4 dm[]; };         // occluder moments

layout(push_constant) uniform PC {
    vec4 origin;
    ivec4 counts;   // xyz probe grid, w = rays per probe
    vec4 sky;
    vec4 spacing;   // x = probe spacing, y = blend, z = phase, w = divisor
    ivec4 brick;    // x = brick size, yzw = brick grid dims
    ivec4 scroll;   // xyz = origin brick-lattice coord
    vec4 vox0;      // voxel grid: xyz = origin (world), w = voxel spacing
    ivec4 voxCounts;// voxel grid dimensions
} pc;

int pmod(int a, int b) { return ((a % b) + b) % b; }
int axisFace(vec3 d) {
    vec3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) return d.x >= 0.0 ? 0 : 1;
    if (a.y >= a.z) return d.y >= 0.0 ? 2 : 3;
    return d.z >= 0.0 ? 4 : 5;
}
vec3 sphereDir(int i, int n) {
    const float golden = 2.39996323;
    float y = 1.0 - (float(i) + 0.5) / float(n) * 2.0;
    float r = sqrt(max(0.0, 1.0 - y * y));
    float t = golden * float(i);
    return vec3(cos(t) * r, y, sin(t) * r);
}
vec4 shBasis(vec3 d) { return vec4(0.282095, 0.488603 * d.y, 0.488603 * d.z, 0.488603 * d.x); }
float shEval(vec4 c, vec3 n) {
    return max(0.886227 * c.x + 1.023328 * (c.y * n.y + c.z * n.z + c.w * n.x), 0.0);
}
ivec3 floorDivB(ivec3 a, int b) { return ivec3(floor(vec3(a) / float(b))); }

vec3 sampleField(vec3 wp, vec3 n) {
    int B = pc.brick.x;
    ivec3 bc = pc.brick.yzw;
    ivec3 ob = pc.scroll.xyz;
    vec3 g = wp / pc.spacing.x;
    ivec3 base = ivec3(floor(g));
    vec3 f = g - vec3(base);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 8; ++i) {
        ivec3 o = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 pl = base + o;
        ivec3 bl = floorDivB(pl, B);
        if (any(lessThan(bl, ob)) || any(greaterThanEqual(bl, ob + bc))) continue;
        ivec3 bs = ivec3(pmod(bl.x, bc.x), pmod(bl.y, bc.y), pmod(bl.z, bc.z));
        int bIdx = (bs.z * bc.y + bs.y) * bc.x + bs.x;
        int slot = brickSlot[bIdx];
        if (slot < 0) continue;
        ivec3 lp = pl - bl * B;
        int q = slot * (B * B * B) + (lp.z * B + lp.y) * B + lp.x;
        vec3 w3 = mix(1.0 - f, f, vec3(o));
        float w = w3.x * w3.y * w3.z;
        sum += w * vec3(shEval(probes[q * 3 + 0], n), shEval(probes[q * 3 + 1], n),
                        shEval(probes[q * 3 + 2], n));
        wsum += w;
    }
    return wsum > 0.0 ? sum / wsum : vec3(0.0);
}

vec3 unpackAlbedo(uint p) { return vec3(uvec3(p >> 16, p >> 8, p) & 0xFFu) / 255.0; }
vec3 unpackNormal(uint p) {
    return vec3(uvec3(p >> 16, p >> 8, p) & 0xFFu) / 255.0 * 2.0 - 1.0;
}

// DDA-march the voxel grid (Amanatides & Woo). On the first occupied voxel, returns its baked
// albedo + normal and the entry distance; else a miss.
bool traceVoxel(vec3 ro, vec3 rd, float tmax, out vec3 alb, out vec3 nrm, out float hitT) {
    vec3 org = pc.vox0.xyz;
    float sp = pc.vox0.w;
    ivec3 dim = pc.voxCounts.xyz;
    ivec3 vi = ivec3(floor((ro - org) / sp));
    ivec3 stp = ivec3(sign(rd));
    vec3 inv = 1.0 / max(abs(rd), vec3(1e-8));
    vec3 tDelta = sp * inv;                              // world distance to cross one voxel
    // Distance to the first voxel boundary on each axis.
    vec3 nextB = org + (vec3(vi) + max(vec3(stp), vec3(0.0))) * sp;
    vec3 tMax = (nextB - ro) * (1.0 / mix(vec3(1e-8), rd, notEqual(rd, vec3(0.0))));
    for (int a = 0; a < 3; ++a) if (rd[a] == 0.0) tMax[a] = 3.4e38;
    float t = 0.0;
    for (int iter = 0; iter < 512; ++iter) {
        if (all(greaterThanEqual(vi, ivec3(0))) && all(lessThan(vi, dim))) {
            uint packed = voxels[uint((vi.z * dim.y + vi.y) * dim.x + vi.x)].x;
            if ((packed >> 24) != 0u) { // occupied
                alb = unpackAlbedo(packed);
                uint np = voxels[uint((vi.z * dim.y + vi.y) * dim.x + vi.x)].y;
                nrm = normalize(unpackNormal(np));
                hitT = t;
                return true;
            }
        }
        // Advance to the next voxel along the axis with the nearest boundary.
        if (tMax.x < tMax.y && tMax.x < tMax.z) { vi.x += stp.x; t = tMax.x; tMax.x += tDelta.x; }
        else if (tMax.y < tMax.z) { vi.y += stp.y; t = tMax.y; tMax.y += tDelta.y; }
        else { vi.z += stp.z; t = tMax.z; tMax.z += tDelta.z; }
        if (t > tmax) break;
        if (any(lessThan(vi, ivec3(0))) || any(greaterThanEqual(vi, dim))) {
            if (t > 0.0) break; // left the grid
        }
    }
    return false;
}

vec3 shadeVoxelHit(vec3 alb, vec3 n, vec3 hitPos) {
    vec3 sun = normalize(vec3(0.4, 1.0, 0.3));
    float d = max(dot(n, sun), 0.0);
    vec3 indirect = sampleField(hitPos, n) * 0.3183099; // previous-frame irradiance / pi
    return alb * (0.3 + 0.7 * d + indirect);
}

void main() {
    int p = int(gl_GlobalInvocationID.x);
    int total = pc.counts.x * pc.counts.y * pc.counts.z;
    if (p >= total) return;
    int divisor = int(pc.spacing.w);
    if (divisor > 1 && (p % divisor) != int(pc.spacing.z)) return;
    int px = p % pc.counts.x;
    int py = (p / pc.counts.x) % pc.counts.y;
    int pz = p / (pc.counts.x * pc.counts.y);
    int B = pc.brick.x;
    ivec3 bc = pc.brick.yzw;
    ivec3 bs = ivec3(px, py, pz) / B;
    int bIdx = (bs.z * bc.y + bs.y) * bc.x + bs.x;
    int slot = brickSlot[bIdx];
    if (slot < 0) return;
    ivec3 obMod = ivec3(pmod(pc.scroll.x, bc.x), pmod(pc.scroll.y, bc.y), pmod(pc.scroll.z, bc.z));
    ivec3 rel = ivec3(pmod(bs.x - obMod.x, bc.x), pmod(bs.y - obMod.y, bc.y),
                      pmod(bs.z - obMod.z, bc.z));
    ivec3 bl = pc.scroll.xyz + rel;
    ivec3 lp = ivec3(px, py, pz) - bs * B;
    int po = slot * (B * B * B) + (lp.z * B + lp.y) * B + lp.x;
    vec3 probePos = vec3(bl * B + lp) * pc.spacing.x;

    int n = pc.counts.w;
    vec4 accR = vec4(0.0), accG = vec4(0.0), accB = vec4(0.0);
    float maxDist = pc.spacing.x * 8.0;
    vec2 dacc[6];
    float dcnt[6];
    for (int k = 0; k < 6; ++k) { dacc[k] = vec2(0.0); dcnt[k] = 0.0; }
    for (int i = 0; i < n; ++i) {
        vec3 dir = sphereDir(i, n);
        vec3 L;
        float dist;
        vec3 alb, nrm;
        float ht;
        if (traceVoxel(probePos, dir, 1000.0, alb, nrm, ht)) {
            L = shadeVoxelHit(alb, nrm, probePos + dir * ht);
            dist = min(ht, maxDist);
        } else {
            L = pc.sky.rgb;
            dist = maxDist;
        }
        vec4 Y = shBasis(dir);
        accR += L.r * Y;
        accG += L.g * Y;
        accB += L.b * Y;
        int fc = axisFace(dir);
        dacc[fc] += vec2(dist, dist * dist);
        dcnt[fc] += 1.0;
    }
    float w = 4.0 * 3.14159265 / float(n);
    float blend = pc.spacing.y;
    probes[po * 3 + 0] = mix(probes[po * 3 + 0], accR * w, blend);
    probes[po * 3 + 1] = mix(probes[po * 3 + 1], accG * w, blend);
    probes[po * 3 + 2] = mix(probes[po * 3 + 2], accB * w, blend);

    vec4 pv0 = dm[po * 3 + 0], pv1 = dm[po * 3 + 1], pv2 = dm[po * 3 + 2];
    vec2 m0 = dcnt[0] > 0.0 ? mix(pv0.xy, dacc[0] / dcnt[0], blend) : pv0.xy;
    vec2 m1 = dcnt[1] > 0.0 ? mix(pv0.zw, dacc[1] / dcnt[1], blend) : pv0.zw;
    vec2 m2 = dcnt[2] > 0.0 ? mix(pv1.xy, dacc[2] / dcnt[2], blend) : pv1.xy;
    vec2 m3 = dcnt[3] > 0.0 ? mix(pv1.zw, dacc[3] / dcnt[3], blend) : pv1.zw;
    vec2 m4 = dcnt[4] > 0.0 ? mix(pv2.xy, dacc[4] / dcnt[4], blend) : pv2.xy;
    vec2 m5 = dcnt[5] > 0.0 ? mix(pv2.zw, dacc[5] / dcnt[5], blend) : pv2.zw;
    dm[po * 3 + 0] = vec4(m0, m1);
    dm[po * 3 + 1] = vec4(m2, m3);
    dm[po * 3 + 2] = vec4(m4, m5);
}
