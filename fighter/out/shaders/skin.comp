#version 450

// Compute skinning: pose a rigged mesh ONCE per frame into a plain vertex buffer,
// which is then drawn as an ordinary mesh (so skinned meshes use regular mesh
// materials, and the skinning cost is shared across every render pass).
//
// The in/out structs use SCALAR members so std430 packs them to the exact byte
// layout of C++ bb::SkinnedVertex (64 B) and bb::Vertex (32 B) — a `vec3` member
// would get 16-byte alignment and mismatch the tightly-packed C++ structs.
layout(local_size_x = 64) in;

struct SkinnedVertex {           // matches bb::SkinnedVertex (64 bytes)
    float px, py, pz;            // pos
    float nx, ny, nz;            // normal
    float u, v;                  // uv
    uint  j0, j1, j2, j3;        // joints
    float w0, w1, w2, w3;        // weights
};

struct Vertex {                  // matches bb::Vertex (32 bytes)
    float px, py, pz;
    float nx, ny, nz;
    float u, v;
};

layout(std430, set = 0, binding = 0) readonly  buffer In      { SkinnedVertex sv[]; };
layout(std430, set = 0, binding = 1) readonly  buffer Palette { mat4 palette[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Out     { Vertex ov[]; };

layout(push_constant) uniform Push {
    uint vertexCount;
    uint boneBase;   // start of this instance's palette slice in the shared buffer
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.vertexCount) return;

    SkinnedVertex s = sv[i];
    mat4 skin = s.w0 * palette[pc.boneBase + s.j0]
              + s.w1 * palette[pc.boneBase + s.j1]
              + s.w2 * palette[pc.boneBase + s.j2]
              + s.w3 * palette[pc.boneBase + s.j3];

    vec3 p = (skin * vec4(s.px, s.py, s.pz, 1.0)).xyz; // posed, model space
    vec3 n = mat3(skin) * vec3(s.nx, s.ny, s.nz);

    ov[i].px = p.x; ov[i].py = p.y; ov[i].pz = p.z;
    ov[i].nx = n.x; ov[i].ny = n.y; ov[i].nz = n.z;
    ov[i].u = s.u;  ov[i].v = s.v;
}
